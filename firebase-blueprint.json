        "evidenceVideoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "updatedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "component",
        "indicatorCode",
        "indicatorTitle",
        "targetScore",
        "achievedScore",
        "status",
        "evidenceSummary",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
