{
  "entities": {
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Authoritative marker document granting admin privileges to a verified UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150
        },
        "assignedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "assignedBy", "createdAt"]
    },
    "SiteMediaConfig": {
      "title": "SiteMediaConfig",
      "description": "School-wide visual media configuration (campus hero photo, principal portrait, profile video, school profile document).",
      "type": "object",
      "properties": {
        "heroImageUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "heroVideoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "principalPhotoUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "schoolProfileDocUrl": {
          "type": "string",
          "maxLength": 500
        },
        "updatedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["heroImageUrl", "principalPhotoUrl", "updatedBy", "createdAt", "updatedAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Portal user account for Kepala Sekolah/Admin, Guru, and Orang Tua Murid.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["admin", "guru", "orangtua"]
        },
        "nipOrNik": {
          "type": "string",
          "maxLength": 40
        },
        "rombel": {
          "type": "string",
          "maxLength": 40
        },
        "phone": {
          "type": "string",
          "maxLength": 25
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "linkedStudentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "status": {
          "type": "string",
          "enum": ["aktif", "nonaktif"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["displayName", "email", "role", "status", "createdAt", "updatedAt"]
    },
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Public directory entry for SDN Cikawao Principal and 8 Teachers (non-PII).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "nip": {
          "type": "string",
          "maxLength": 40
        },
        "position": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "rank": {
          "type": "string",
          "maxLength": 60
        },
        "rombel": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["Aktif", "Cuti"]
        },
        "displayOrder": {
          "type": "number"
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "documentUrl": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "position", "rombel", "status", "displayOrder", "createdAt", "updatedAt"]
    },
    "StudentRecord": {
      "title": "StudentRecord",
      "description": "Integrated student profile and real-time Kurikulum Merdeka academic monitoring.",
      "type": "object",
      "properties": {
        "nisn": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[0-9a-zA-Z\\-]+$"
        },
        "nik": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[0-9]*$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "rombel": {
          "type": "string",
          "enum": ["Kelas 1", "Kelas 2", "Kelas 3", "Kelas 4", "Kelas 5", "Kelas 6"]
        },
        "gender": {
          "type": "string",
          "enum": ["L", "P"]
        },
        "parentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "parentEmail": {
          "type": "string",
          "maxLength": 150
        },
        "teacherEmail": {
          "type": "string",
          "maxLength": 150
        },
        "attendancePercent": {
          "type": "number"
        },
        "nilaiFormatif": {
          "type": "number"
        },
        "nilaiSumatif": {
          "type": "number"
        },
        "capaianP5": {
          "type": "string",
          "enum": ["Mulai Berkembang", "Sedang Berkembang", "Berkembang Sesuai Harapan", "Sangat Berkembang"]
        },
        "academicNote": {
          "type": "string",
          "maxLength": 500
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "documentUrl": {
          "type": "string",
          "maxLength": 500
        },
        "updatedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "nisn",
        "fullName",
        "rombel",
        "gender",
        "parentName",
        "parentEmail",
        "teacherEmail",
        "attendancePercent",
        "nilaiFormatif",
        "nilaiSumatif",
        "capaianP5",
        "academicNote",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "NewsArticle": {
      "title": "NewsArticle",
      "description": "School news and Kegiatan Belajar Mengajar (KBM) updates with photo, video, and documentation.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": ["KBM", "Prestasi", "Kurikulum Merdeka", "Kegiatan Sekolah", "Ekstrakulikuler"]
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 320
        },
        "content": {
          "type": "string",
          "minLength": 10,
          "maxLength": 4000
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "tiktokUrl": {
          "type": "string",
          "maxLength": 500
        },
        "documentUrl": {
          "type": "string",
          "maxLength": 500
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "publishedDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "category", "summary", "content", "imageUrl", "authorName", "authorUid", "publishedDate", "createdAt", "updatedAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "School photo and video gallery accessible to parents and the public.",
