        "endDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "targetRombel": {
          "type": "string",
          "enum": ["Semua Kelas", "Kelas 1", "Kelas 2", "Kelas 3", "Kelas 4", "Kelas 5", "Kelas 6"]
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 600
        },
        "isHoliday": {
          "type": "boolean"
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
