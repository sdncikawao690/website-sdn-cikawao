  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted admin role marker documents."
    },
    "/site_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteMediaConfig" },
