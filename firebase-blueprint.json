    "SilokaTicket": {
      "title": "SilokaTicket",
      "description": "SILOKA responsive community complaint and feedback ticket with photo/video/documentation attachments.",
      "type": "object",
      "properties": {
        "ticketCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "reporterUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reporterName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "reporterEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150
        },
        "reporterPhone": {
          "type": "string",
          "maxLength": 25
        },
        "category": {
          "type": "string",
          "enum": [
            "Perencanaan",
            "Pengorganisasian",
            "Pelaksana",
            "Program Unggulan",
            "Evaluasi",
            "Layanan Akademik",
            "Sarana Prasarana",
            "Kesiswaan",
            "Ekstrakurikuler",
            "Saran & Aspirasi"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "documentUrl": {
          "type": "string",
          "maxLength": 200000
        },
        "documentName": {
          "type": "string",
          "maxLength": 150
        },
        "status": {
          "type": "string",
          "enum": ["Menunggu", "Diproses", "Selesai"]
        },
        "officialResponse": {
          "type": "string",
          "maxLength": 1000
        },
        "responsePhotoUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "responseDocUrl": {
          "type": "string",
          "maxLength": 200000
        },
        "responseDocName": {
          "type": "string",
          "maxLength": 150
        },
        "respondedBy": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ticketCode",
        "reporterUid",
        "reporterName",
        "reporterEmail",
        "category",
        "subject",
        "description",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
