          "maxLength": 150
        },
        "message": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1000
        },
        "priority": {
          "type": "string",
          "enum": ["Penting", "Mendesak", "Informasi"]
        },
        "targetRombel": {
          "type": "string",
          "enum": ["Semua Kelas", "Kelas 1", "Kelas 2", "Kelas 3", "Kelas 4", "Kelas 5", "Kelas 6"]
        },
        "autoNotifyParents": {
          "type": "boolean"
        },
        "isActive": {
          "type": "boolean"
        },
        "photoUrl": {
          "type": "string",
