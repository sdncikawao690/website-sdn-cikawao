    "PkksItem": {
      "title": "PkksItem",
      "description": "Penilaian Kinerja Kepala Sekolah (PKKS) component and photo/video/document evidence tracking.",
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "Kompetensi Kepribadian",
            "Kompetensi Sosial",
            "Kompetensi Profesional",
            "Kepribadian & Sosial",
            "Kepemimpinan Pembelajaran",
            "Pengembangan Sekolah",
            "Manajemen Sumber Daya",
            "Kewirausahaan",
            "Supervisi Guru & Tendik"
          ]
        },
        "indicatorCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "indicatorTitle": {
          "type": "string",
          "minLength": 4,
          "maxLength": 180
        },
        "targetScore": {
          "type": "number"
        },
        "achievedScore": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Terpenuhi", "Proses Verifikasi", "Perlu Lengkapi"]
